# Copy this file to .env and fill in real values. Never commit the real .env file.

# A long, random, unpredictable string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-this-to-a-random-secret-key

# Set to False in production.
DEBUG=True

# Comma-separated list of hostnames this site is allowed to serve.
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite for local development. For production, use a real Postgres URL, e.g.:
#   DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///db.sqlite3
